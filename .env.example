# Copia este archivo a backend/.env solo si quieres cambiar los valores.
# Sin archivo .env el backend usa estos defaults.

PORT=3001
DATA_DIR=./data

# El frontend en local no necesita variables: Vite reenvía /api al puerto 3001.
# Si apuntas el frontend directo al backend, descomenta la línea y activa CORS (ya viene abierto).
# VITE_API_BASE_URL=http://localhost:3001
